_INVISIBLE = "\u00ad\u200b\ufeff\u2060"
_SPECIAL_SPACES = "\u00a0\u2007\u202f\u2009\u200a\u2002\u2003"


def _normalize_ws(text):
    return re.sub(r"\s+", " ", text).strip()


def _now_iso():
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%S.%f")[:-3] + "Z"


# ──────────────────────────────────────────────────────────────────────────────
#  PDF-подсветка
# ──────────────────────────────────────────────────────────────────────────────

LANGS = [
    "ÁáČčĎďÉéĚěÍíŇňÓóŘřŠšŤťÚúŮůÝýŽž",
    "ÄäÖöÜüẞß",
    "ĄąĆćĘęŁłŃńÓóŚśŹźŻż",
    "À-ú",
    "Ёё",
]
TOKEN_RE = re.compile(r"[A-Za-zА-Яа-я0-9!?.,;:'\"" + "".join(LANGS) + "]")


def tokenize(text):
    return TOKEN_RE.findall(text)


def build_text_index(doc):
    chars = []
    records = []
    for page_index, page in enumerate(doc):
        textpage = page.get_textpage(flags=fitz.TEXT_MEDIABOX_CLIP)
        for word_info in textpage.extractWORDS():
            word = word_info[4]
            rect = fitz.Rect(word_info[:4])
            line_key = round(rect.y0, 1)
            for token in tokenize(word):
                for char in token:
                    chars.append(char)
                    records.append((page_index, rect, line_key))
    return "".join(chars), records


HIGHLIGHT_ANNOT_TYPE = getattr(fitz, "PDF_ANNOT_HIGHLIGHT", 8)


def remove_existing_highlights(doc):
    removed_count = 0
    for page in doc:
        annots = list(page.annots() or [])
        for annot in annots:
            if annot.type[0] == HIGHLIGHT_ANNOT_TYPE:
                page.delete_annot(annot)
                removed_count += 1
    if removed_count:
        print(f"  Removed {removed_count} existing PDF highlight(s)")


def _add_highlights_to_pdf(doc_filename, citations):
    doc = fitz.open(doc_filename)
    num_found = num_not_found = 0
    try:
        remove_existing_highlights(doc)
        text, records = build_text_index(doc)
        search_from = 0
        for citation, _, note in sorted(citations, key=lambda item: item[1]):
            for part in citation.split("\n"):
                needle = "".join(tokenize(part))
                if not needle:
                    continue
                pos = text.find(needle, search_from)
                if pos < 0:
                    pos = text.find(needle)
                if pos < 0:
                    num_not_found += 1
                    continue
                groups = []
                for page_index, rect, line_key in records[pos : pos + len(needle)]:
                    key = (page_index, line_key)
                    if groups and groups[-1][0] == key:
                        groups[-1][1] |= rect
                    else:
                        groups.append([key, fitz.Rect(rect)])
                for (page_index, _), rect in groups:
                    page = doc[page_index]
                    annot = page.add_highlight_annot(rect)
                    if note:
                        annot.set_info(content=note)
                    annot.update()
                search_from = pos + len(needle)
                num_found += 1
        if num_found:
            doc.saveIncr()
    finally:
        doc.close()
    print(f"  Citations found: {num_found}")
    if num_not_found:
        print(f"  Citations not found: {num_not_found}")
    return num_found, num_not_found


def book_to_pdf(book_filename, pdf_filename):
    if shutil.which("ebook-convert") is None:
        raise RuntimeError(
            f"ebook-convert not found. Install Calibre to convert {book_filename} to PDF."
        )
    subprocess.check_call(["ebook-convert", str(book_filename), str(pdf_filename)])


# ──────────────────────────────────────────────────────────────────────────────
#  Генератор EPUB CFI
# ──────────────────────────────────────────────────────────────────────────────


class EpubCfiGenerator:
    def __init__(self, epub_path):
        self.epub_path = Path(epub_path)
        self.opf_path = None
        self.opf_dir = ""
        self.manifest = {}
        self.spine = []
        self._parse_opf()

    def _parse_opf(self):
        with ZipFile(self.epub_path) as zf:
            try:
                container_xml = zf.read("META-INF/container.xml")
                root = ET.fromstring(container_xml)
                ns = {"c": "urn:oasis:names:tc:opendocument:xmlns:container"}
                rootfile = root.find(".//c:rootfile", ns)
                if rootfile is None:
                    rootfile = root.find(".//rootfile")
                if rootfile is not None:
                    self.opf_path = rootfile.get("full-path")
            except (KeyError, ET.ParseError):
                for name in zf.namelist():
                    if name.endswith(".opf"):
                        self.opf_path = name
                        break
            if self.opf_path is None:
                return
            self.opf_dir = str(Path(self.opf_path).parent)
            if self.opf_dir == ".":
                self.opf_dir = ""
            opf_xml = zf.read(self.opf_path)
            root = ET.fromstring(opf_xml)
            for elem in root.iter():
                tag = elem.tag.split("}")[-1] if "}" in elem.tag else elem.tag
                if tag == "item":
                    item_id = elem.get("id")
                    href = elem.get("href", "")
                    if item_id and href:
                        self.manifest[item_id] = {"href": unquote(href)}
            spine_elem = None
            for elem in root.iter():
                tag = elem.tag.split("}")[-1] if "}" in elem.tag else elem.tag
                if tag == "spine":
                    spine_elem = elem
                    break
            if spine_elem is not None:
                for i, elem in enumerate(spine_elem):
                    tag = elem.tag.split("}")[-1] if "}" in elem.tag else elem.tag
                    if tag == "itemref":
                        itemref_id = elem.get("id") or f"itemref_{i}"
                        idref = elem.get("idref", "")
                        if idref:
                            self.spine.append((itemref_id, idref))

    def get_book_identifier(self):
        with ZipFile(self.epub_path) as zf:
            if self.opf_path:
                try:
                    opf_xml = zf.read(self.opf_path)
                    root = ET.fromstring(opf_xml)
                    for elem in root.iter():
                        tag = elem.tag.split("}")[-1] if "}" in elem.tag else elem.tag
                        if tag == "identifier":
                            text = (elem.text or "").strip()
                            if text:
                                return text
                except (KeyError, ET.ParseError):
                    pass
            md5 = hashlib.md5()
            with open(self.epub_path, "rb") as f:
                remaining = 10_000_000
                while remaining > 0:
                    chunk = f.read(min(65536, remaining))
                    if not chunk:
                        break
                    md5.update(chunk)
                    remaining -= len(chunk)
            return f"foliate:{md5.hexdigest()}"

    def _build_cfi_index(self, html_content):
        try:
            html_content = re.sub(r'\s+xmlns\s*=\s*"[^"]*"', "", html_content, count=1)
            root = ET.fromstring(html_content)
        except ET.ParseError:
            return []
        index = []

        def walk(elem, parent_steps):
            nodes = []
            if elem.text is not None:
                nodes.append(("text", elem.text))
            for child in elem:
                nodes.append(("elem", child))
                if child.tail is not None:
                    nodes.append(("text", child.tail))
            elem_counter = 0
            text_counter = 0
            for node_type, node_value in nodes:
                if node_type == "elem":
                    elem_counter += 1
                    tag = (
                        node_value.tag.split("}")[-1]
                        if "}" in node_value.tag
                        else node_value.tag
                    )
                    step = (elem_counter * 2, tag, node_value.get("id"))
                    walk(node_value, parent_steps + [step])
                else:
                    text_counter += 1
                    if node_value:
                        text_steps = parent_steps + [(text_counter * 2 - 1, None, None)]
                        for char_offset, char in enumerate(node_value):
                            index.append((list(text_steps), char_offset, char))

        walk(root, [])
        return index

    def _locate_citation(self, zf, citation_text, debug=False):
        norm_citation = _normalize_ws(citation_text)
        if not norm_citation:
            return None
        if debug:
            print(f"  [DEBUG] Ищем: {norm_citation[:80]!r}")
        for spine_idx, (itemref_id, idref) in enumerate(self.spine):
            item = self.manifest.get(idref)
            if not item:
                continue
            href = item["href"]
            full_path = f"{self.opf_dir}/{href}" if self.opf_dir else href
            html_content = None
            for p in [full_path, href]:
                try:
                    html_content = zf.read(p).decode("utf-8", errors="replace")
                    break
                except KeyError:
                    continue
            if html_content is None:
                if debug:
                    print(f"  [DEBUG]   {href}: файл не найден")
                continue
            index = self._build_cfi_index(html_content)
            if not index:
                if debug:
                    print(f"  [DEBUG]   {href}: индекс пуст")
                continue
            full_text = "".join(ch for _, _, ch in index)
            norm_full = _normalize_ws(full_text)
            if debug and spine_idx < 2:
                print(f"  [DEBUG]   {href}: {len(full_text)} символов")
                print(f"  [DEBUG]   Начало текста: {norm_full[:150]!r}")
            pos = norm_full.find(norm_citation)
            if pos < 0:
                continue
            if debug:
                print(f"  [DEBUG]   НАЙДЕНО в {href} на позиции {pos}")
            norm_to_orig = []
            prev_space = False
            for i, (_, _, ch) in enumerate(index):
                if ch in _INVISIBLE:
                    continue
                mapped_ch = " " if (ch in _SPECIAL_SPACES or ch in "\n\r\t") else ch
                if mapped_ch == " ":
                    if prev_space:
                        continue
                    prev_space = True
                else:
                    prev_space = False
                norm_to_orig.append(i)
            end_pos = pos + len(norm_citation)
            if pos >= len(norm_to_orig) or end_pos > len(norm_to_orig):
                continue
            start_orig = norm_to_orig[pos]
            end_orig = norm_to_orig[end_pos - 1]
            start_steps, start_offset, _ = index[start_orig]
            end_steps, end_offset, _ = index[end_orig]
            return (
                spine_idx,
                itemref_id,
                href,
                start_steps,
                start_offset,
                end_steps,
                end_offset,
            )
        if debug:
            print(f"  [DEBUG]   НЕ НАЙДЕНО")
        return None

    def _steps_to_path(self, steps):
        parts = []
        for step in steps:
            idx = step[0]
            elem_id = step[2] if len(step) > 2 else None
            if elem_id:
                parts.append(f"/{idx}[{elem_id}]")
            else:
                parts.append(f"/{idx}")
        return "".join(parts)

    def _build_range_cfi(
        self, spine_num, itemref_id, start_steps, start_offset, end_steps, end_offset
    ):
        if itemref_id:
            base = f"/6/{spine_num}[{itemref_id}]!"
        else:
            base = f"/6/{spine_num}!"
        common = []
        for a, b in zip(start_steps[:-1], end_steps[:-1]):
            if a[0] == b[0]:
                common.append(a)
            else:
                break
        parent_path = self._steps_to_path(common)
        start_sub = self._steps_to_path(start_steps[len(common) :]) + f":{start_offset}"
        end_sub = self._steps_to_path(end_steps[len(common) :]) + f":{end_offset}"
        return f"epubcfi({base}{parent_path},{start_sub},{end_sub})"

    def find_cfi_for_citation(self, zf, citation_text):
        loc = self._locate_citation(zf, citation_text)
        if not loc:
            return None
        spine_idx, itemref_id, href, s_steps, s_off, e_steps, e_off = loc
        return self._build_range_cfi(
            (spine_idx + 1) * 2, itemref_id, s_steps, s_off, e_steps, e_off + 1
        )

    def find_citation_location(self, zf, citation_text):
        loc = self._locate_citation(zf, citation_text)
        if not loc:
            return None
        spine_idx, itemref_id, href, s_steps, s_off, e_steps, e_off = loc
        return {
            "spine_index": spine_idx,
            "spine_name": href,
            "start_cfi": self._steps_to_path(s_steps) + f":{s_off}",
            "end_cfi": self._steps_to_path(e_steps) + f":{e_off + 1}",
        }


