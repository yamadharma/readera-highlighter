@dataclass
class BookInfo:
    title: str
    filename: str
    citations: set = field(default_factory=set)


# --------------------------------------------------- чтение бэкапов ---


def find_library_data_in_zip(zf):
    names = zf.namelist()

    # Старый формат: один library.json
    if "library.json" in names:
        return ("single", "library.json")
    for name in names:
        if name.endswith("/library.json") or name.endswith("\\library.json"):
            return ("single", name)

    # Новый формат: фрагменты docs_N.json
    docs_files = []
    for name in names:
        basename = name.split("/")[-1].split("\\")[-1]
        if basename.startswith("docs_") and basename.endswith(".json"):
            docs_files.append(name)

    if docs_files:

        def extract_number(filename):
            basename = filename.split("/")[-1].split("\\")[-1]
            num_part = basename[5:-5]
            try:
                return int(num_part)
            except ValueError:
                return 0

        docs_files.sort(key=extract_number)
        return ("split", docs_files)

    print(f"Archive contents ({len(names)} files):")
    for name in sorted(names)[:30]:
        print(f"  {name}")
    if len(names) > 30:
        print(f"  ... and {len(names) - 30} more")
    return None


def load_library_data(zf, library_info):
    if library_info is None:
        return None

    fmt, data = library_info

    if fmt == "single":
        with zf.open(data) as f:
            return json.load(f)

    elif fmt == "split":
        # Каждый docs_N.json — самостоятельный JSON-массив объектов.
        all_docs = []
        for filename in data:
            with zf.open(filename) as f:
                content = f.read().decode("utf-8").strip()
            try:
                docs = json.loads(content)
                if isinstance(docs, list):
                    all_docs.extend(docs)
                    print(f"    {filename}: {len(docs)} books")
                else:
                    print(f"    {filename}: unexpected type {type(docs).__name__}")
            except json.JSONDecodeError:
                stripped = content.lstrip(" \t\n\r,")
                try:
                    docs = json.loads("[" + stripped + "]")
                    all_docs.extend(docs)
                    print(f"    {filename}: {len(docs)} books (continuation)")
                except json.JSONDecodeError as e:
                    print(f"    {filename}: FAILED to parse: {e}")
                    return None
        print(f"    Total: {len(all_docs)} books")
        return {"docs": all_docs}

    return None


def get_all_citations(readera_backup_filename, state="all"):
    uris_to_book_infos = {}
    print(f"Reading {readera_backup_filename}")

    with ZipFile(readera_backup_filename) as backup_file:
        library_info = find_library_data_in_zip(backup_file)
        if library_info is None:
            raise FileNotFoundError(
                f"No library data found in {readera_backup_filename}. "
                "Expected library.json or docs_*.json files."
            )

        fmt, data = library_info
        if fmt == "single":
            print(f"  Found old format: {data}")
        else:
            print(f"  Found new format: {len(data)} fragments")

        library_data = load_library_data(backup_file, library_info)
        if library_data is None:
            raise ValueError(
                f"Failed to parse library data from {readera_backup_filename}"
            )

    for doc in library_data.get("docs", []):
        doc_data = doc.get("data", {})

        if state == "readed" and not doc_data.get("doc_have_read_time", 0):
            continue

        book_title = (
            doc_data.get("doc_title")
            or doc_data.get("doc_file_name_title")
            or "Untitled"
        )
        book_format = str(doc_data.get("doc_format", "epub")).lower()
        doc_links = doc.get("links") or []

        if doc_links and doc_links[0].get("file_name"):
            book_filename = doc_links[0]["file_name"]
        else:
            book_filename = f"{book_title}.{book_format}"

        book_info = BookInfo(book_title, book_filename, set())
        uris_to_book_infos[doc["uri"]] = book_info

        for citation in doc.get("citations", []):
            body = citation.get("note_body")
            if not body:
                continue
            position = (citation.get("note_page") or 0) + (
                citation.get("note_index") or 0
            )
            book_info.citations.add((body, position, citation.get("note_extra")))

    return uris_to_book_infos


def find_backup_path(backup_path):
    env_path = os.getenv("READERA_BACKUP")
    if env_path:
        return Path(env_path)
    candidates = tuple(Path(os.path.expanduser(backup_path)).glob("ReadEra*.bak"))
    if not candidates:
        print(f"Did not find any ReadEra backup in {backup_path}")
        return None
    return max(candidates, key=lambda f: f.stat().st_mtime)


# ---------------------------------------------------------------- режимы ---


def verify_citations_complete(backup_path):
    all_infos = {}
    backups_to_map = {}

    for filename in sorted(
        Path(os.path.expanduser(backup_path)).glob("ReadEra*bak"),
        reverse=True,
    ):
        infos = get_all_citations(filename)
        backups_to_map[filename] = infos
        for uri, book_info in infos.items():
            if uri not in all_infos:
                all_infos[uri] = BookInfo(book_info.title, book_info.filename, set())
            all_infos[uri].citations.update(book_info.citations)

    for filename, infos in backups_to_map.items():
        print(f"Checking {filename}")
        complete = True
        for uri, full_info in all_infos.items():
            current = infos.get(uri)
            if current is None:
                print(f"  Missing title: {full_info.title}")
                complete = False
                continue
            missing = full_info.citations - current.citations
            for citation in sorted(missing, key=lambda item: item[1]):
                print(f"  Missing citation: {full_info.title} / {citation}")
                complete = False
        if complete:
            print("  Contains all citations")


def show_titles(readera_backup_filename, state="all"):
    infos = get_all_citations(readera_backup_filename, state)
    for book_info in sorted(infos.values(), key=lambda b: b.title):
        if book_info.citations:
            print(f"{book_info.title}, Citations: {len(book_info.citations)}")


def get_citations_by_file(readera_backup_filename, book_filename, state="all"):
    wanted = Path(book_filename).name
    infos = get_all_citations(readera_backup_filename, state)
    for book_info in infos.values():
        if Path(book_info.filename).name == wanted:
            return book_info
    return None


def show_citations_for_book(readera_backup_filename, book, state="all"):
    if Path(book).is_file():
        print(f"Searching for file '{book}'")
        book_info = get_citations_by_file(
            readera_backup_filename, Path(book).name, state
        )
    else:
        print(f"Searching for title '{book}'")
        infos = get_all_citations(readera_backup_filename, state)
        book_info = next(
            (b for b in infos.values() if book.lower() in b.title.lower()),
            None,
        )

    if not book_info:
        print("Book not found")
        return

    print(f"Book: {book_info.title}")
    for citation in sorted(book_info.citations, key=lambda item: item[1]):
        print(f"- {citation[0]}\n")


# -------------------------------------------------------- токенизация ---

LANGS = [
    "ÁáČčĎďÉéĚěÍíŇňÓóŘřŠšŤťÚúŮůÝýŽž",  # Czech
    "ÄäÖöÜüẞß",  # German
    "ĄąĆćĘęŁłŃńÓóŚśŹźŻż",  # Polish
    "À-ú",  # Portuguese
    "Ёё",  # Russian
]
TOKEN_RE = re.compile(r"[A-Za-zА-Яа-я0-9!?.,;:'\"" + "".join(LANGS) + "]")


def tokenize(text):
    return TOKEN_RE.findall(text)


def _normalize_ws(text):
    return re.sub(r"\s+", " ", text).strip()


# ------------------------------------------------------- PDF-подсветка ---


def build_text_index(doc):
    chars = []
    records = []
    for page_index, page in enumerate(doc):
        textpage = page.get_textpage(flags=fitz.TEXT_MEDIABOX_CLIP)
        for word_info in textpage.extractWORDS():
            word = word_info[4]
            rect = fitz.Rect(word_info[:4])
            line_key = round(rect.y0, 1)
            for token in tokenize(word):
                for char in token:
                    chars.append(char)
                    records.append((page_index, rect, line_key))
    return "".join(chars), records


HIGHLIGHT_ANNOT_TYPE = getattr(fitz, "PDF_ANNOT_HIGHLIGHT", 8)


def remove_existing_highlights(doc):
    removed_count = 0
    for page in doc:
        annots = list(page.annots() or [])
        for annot in annots:
            if annot.type[0] == HIGHLIGHT_ANNOT_TYPE:
                page.delete_annot(annot)
                removed_count += 1
    if removed_count:
        print(f"  Removed {removed_count} existing PDF highlight(s)")


def _add_highlights_to_pdf(doc_filename, citations):
    doc = fitz.open(doc_filename)
    num_found = num_not_found = 0

    try:
        remove_existing_highlights(doc)
        text, records = build_text_index(doc)
        search_from = 0

        for citation, _, note in sorted(citations, key=lambda item: item[1]):
            for part in citation.split("\n"):
                needle = "".join(tokenize(part))
                if not needle:
                    continue

                pos = text.find(needle, search_from)
                if pos < 0:
                    pos = text.find(needle)

                if pos < 0:
                    num_not_found += 1
                    continue

                groups = []
                for page_index, rect, line_key in records[pos : pos + len(needle)]:
                    key = (page_index, line_key)
                    if groups and groups[-1][0] == key:
                        groups[-1][1] |= rect
                    else:
                        groups.append([key, fitz.Rect(rect)])

                for (page_index, _), rect in groups:
                    page = doc[page_index]
                    annot = page.add_highlight_annot(rect)
                    if note:
                        annot.set_info(content=note)
                    annot.update()

                search_from = pos + len(needle)
                num_found += 1

        if num_found:
            doc.saveIncr()
    finally:
        doc.close()

    print(f"  Citations found: {num_found}")
    if num_not_found:
        print(f"  Citations not found: {num_not_found}")
    return num_found, num_not_found


# ------------------------------------------------------- EPUB-подсветка ---

HIGHLIGHT_CSS = """
/* === ReadEra Highlighter === */
mark.readera-hl {
    background-color: #FFF176;
    color: inherit;
    padding: 0;
    border-radius: 2px;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
}
"""

_MARK_RE = re.compile(
    r'<mark\s+class="readera-hl"[^>]*>(.*?)</mark>',
    re.DOTALL | re.IGNORECASE,
)

# Невидимые символы, которые нужно убрать при сравнении
_INVISIBLE = "\u00ad\u200b\ufeff\u2060"
_SPECIAL_SPACES = "\u00a0\u2007\u202f\u2009\u200a\u2002\u2003"


def _is_xhtml(name):
    if "META-INF" in name:
        return False
    return name.lower().endswith((".xhtml", ".html", ".htm"))


def _extract_text_nodes(html_content):
    """Возвращает диапазоны (старт, конец) текстовых сегментов между тегами."""
    nodes = []
    pos = 0
    for m in re.finditer(r"<[^>]*>", html_content):
        tag_start, tag_end = m.span()
        if tag_start > pos:
            segment = html_content[pos:tag_start]
            if segment.strip():
                nodes.append((pos, tag_start))
        pos = tag_end
    if pos < len(html_content):
        segment = html_content[pos:]
        if segment.strip():
            nodes.append((pos, len(html_content)))
    return nodes


def _build_norm_index(html_content):
    """
    Строит нормализованный видимый текст и маппинг позиций на оригинал.
    Возвращает (norm_text, norm_map), где norm_map[i] — позиция в оригинале.
    """
    nodes = _extract_text_nodes(html_content)
    visible_chars = []
    pos_map = []
    for start, end in nodes:
        segment = html_content[start:end]
        for i, ch in enumerate(segment):
            visible_chars.append(ch)
            pos_map.append(start + i)

    norm_chars = []
    norm_map = []
    prev_space = False
    for ch, orig_pos in zip(visible_chars, pos_map):
        if ch in _INVISIBLE:
            continue
        if ch in _SPECIAL_SPACES or ch in "\n\r\t":
            ch = " "
        if ch == " ":
            if prev_space:
                continue
            prev_space = True
        else:
            prev_space = False
        norm_chars.append(ch)
        norm_map.append(orig_pos)

    return "".join(norm_chars), norm_map


def _find_citation_in_html(html_content, citation_text, index_cache=None):
    """
    Ищет цитату в HTML. Возвращает (старт, конец) в оригинале или None.
    index_cache позволяет переиспользовать индекс для одного файла.
    """
    if index_cache is not None:
        norm_text, norm_map, token_index = index_cache
    else:
        norm_text, norm_map = _build_norm_index(html_content)
        token_index = None

    # 1. Точный поиск нормализованной цитаты
    cleaned = re.sub(f"[{re.escape(_INVISIBLE)}]", "", citation_text)
    norm_citation = _normalize_ws(cleaned)
    if norm_citation:
        idx = norm_text.find(norm_citation)
        if idx != -1 and idx + len(norm_citation) <= len(norm_map):
            orig_start = norm_map[idx]
            orig_end = norm_map[idx + len(norm_citation) - 1] + 1
            return orig_start, orig_end

    # 2. Токенизационный поиск (нечувствителен к пунктуации и переносам)
    cit_tokens = tokenize(citation_text)
    if not cit_tokens:
        return None

    if token_index is None:
        token_index = [
            (m.group(), m.start(), m.end()) for m in TOKEN_RE.finditer(norm_text)
        ]

    if len(cit_tokens) > len(token_index):
        return None

    n = len(cit_tokens)
    first = cit_tokens[0]
    for i in range(len(token_index) - n + 1):
        if token_index[i][0] != first:
            continue
        if all(token_index[i + j][0] == cit_tokens[j] for j in range(1, n)):
            norm_start = token_index[i][1]
            norm_end = token_index[i + n - 1][2]
            if norm_end <= len(norm_map):
                orig_start = norm_map[norm_start]
                orig_end = norm_map[norm_end - 1] + 1
                return orig_start, orig_end

    return None


def _tags_balanced(fragment):
    """Проверяет сбалансированность тегов во фрагменте (через стек)."""
    VOID_TAGS = {
        "br",
        "hr",
        "img",
        "input",
        "meta",
        "link",
        "area",
        "base",
        "col",
        "embed",
        "source",
        "track",
        "wbr",
    }
    stack = []
    for m in re.finditer(r"<(/?)([a-zA-Z][a-zA-Z0-9]*)([^>]*?)(/?)>", fragment):
        closing, tag, _, self_close = m.groups()
        tag = tag.lower()
        if tag in VOID_TAGS or self_close == "/":
            continue
        if closing:
            if not stack or stack[-1] != tag:
                return False
            stack.pop()
        else:
            stack.append(tag)
    return not stack


def _escape_attr(text):
    if not text:
        return ""
    return (
        text.replace("&", "&amp;")
        .replace('"', "&quot;")
        .replace("<", "&lt;")
        .replace(">", "&gt;")
    )


def _insert_marks(html_text, spans):
    """Вставляет <mark> по диапазонам. Вставка с конца, чтобы не смещать позиции."""
    spans = sorted(spans, key=lambda s: s[0])
    # Убираем пересечения и несбалансированные фрагменты
    filtered = []
    last_end = -1
    for start, end, note in spans:
        if start < last_end:
            continue
        if not _tags_balanced(html_text[start:end]):
            continue
        filtered.append((start, end, note))
        last_end = end

    for start, end, note in reversed(filtered):
        note_attr = f' data-note="{_escape_attr(note)}"' if note else ""
        html_text = html_text[:end] + "</mark>" + html_text[end:]
        html_text = (
            html_text[:start]
            + f'<mark class="readera-hl"{note_attr}>'
            + html_text[start:]
        )
    return html_text


def _remove_epub_highlights_in_html(html_text):
    new_text, count = _MARK_RE.subn(r"\1", html_text)
    return new_text, count


def _relative_path(from_file, to_file):
    from_dir = posixpath.dirname(from_file)
    return posixpath.relpath(to_file, from_dir)


def _add_to_opf_manifest(contents, names, css_name):
    opf_files = [n for n in names if n.lower().endswith(".opf")]
    if not opf_files:
        return
    opf_name = opf_files[0]
    opf_text = contents[opf_name].decode("utf-8", errors="replace")
    if css_name in opf_text:
        return
    rel = posixpath.relpath(css_name, posixpath.dirname(opf_name))
    item = f'<item id="readera-hl-css" href="{rel}" media-type="text/css"/>'
    if "</manifest>" in opf_text:
        opf_text = opf_text.replace("</manifest>", item + "</manifest>", 1)
        contents[opf_name] = opf_text.encode("utf-8")


def _inject_highlight_css(contents, names):
    css_files = [n for n in names if n.lower().endswith(".css")]
    if css_files:
        css_file = css_files[0]
        existing = contents[css_file].decode("utf-8", errors="replace")
        if "readera-hl" not in existing:
            contents[css_file] = (existing + HIGHLIGHT_CSS).encode("utf-8")
        return

    css_name = "readera-highlights.css"
    if css_name in names:
        return
    contents[css_name] = HIGHLIGHT_CSS.encode("utf-8")
    names.append(css_name)

    for name in list(names):
        if not _is_xhtml(name):
            continue
        html_text = contents[name].decode("utf-8", errors="replace")
        rel = _relative_path(name, css_name)
        link_tag = f'<link rel="stylesheet" type="text/css" href="{rel}"/>'
        if "</head>" in html_text:
            html_text = html_text.replace("</head>", link_tag + "</head>", 1)
        elif "<body" in html_text:
            html_text = html_text.replace("<body", link_tag + "<body", 1)
        else:
            html_text = link_tag + html_text
        contents[name] = html_text.encode("utf-8")

    _add_to_opf_manifest(contents, names, css_name)


def _write_epub(epub_path, names, contents):
    """Записывает EPUB. mimetype — первым и без сжатия (требование спецификации)."""
    ordered = []
    if "mimetype" in names:
        ordered.append("mimetype")
    for n in names:
        if n != "mimetype":
            ordered.append(n)

    with ZipFile(epub_path, "w", ZIP_DEFLATED) as zout:
        for name in ordered:
            if name == "mimetype":
                zout.writestr(name, contents[name], compress_type=ZIP_STORED)
            else:
                zout.writestr(name, contents[name])


def add_highlights_to_epub(epub_path, citations):
    """
    Добавляет подсветку в EPUB, оборачивая цитаты в <mark> теги.
    Возвращает (число_найденных, число_не_найденных).
    """
    with ZipFile(epub_path) as zin:
        names = zin.namelist()
        contents = {n: zin.read(n) for n in names}

    xhtml_files = [n for n in names if _is_xhtml(n)]
    if not xhtml_files:
        print("  No XHTML files found in EPUB")
        return 0, 0

    # 1. Защита от повторной подсветки + подготовка индексов
    removed_total = 0
    file_indexes = {}
    for xf in xhtml_files:
        html_text = contents[xf].decode("utf-8", errors="replace")
        html_text, removed = _remove_epub_highlights_in_html(html_text)
        removed_total += removed
        contents[xf] = html_text.encode("utf-8")

        norm_text, norm_map = _build_norm_index(html_text)
        token_index = [
            (m.group(), m.start(), m.end()) for m in TOKEN_RE.finditer(norm_text)
        ]
        file_indexes[xf] = (norm_text, norm_map, token_index)

    if removed_total:
        print(f"  Removed {removed_total} existing EPUB highlight(s)")

    # 2. Собираем список частей цитат
    citation_parts = []
    for citation, _, note in sorted(citations, key=lambda item: item[1]):
        for part in citation.split("\n"):
            part = part.strip()
            if part:
                citation_parts.append((part, note))

    # 3. Ищем каждую цитату во всех файлах
    matches = {xf: [] for xf in xhtml_files}
    found_count = 0
    not_found = []

    for part, note in citation_parts:
        found = False
        for xf in xhtml_files:
            html_text = contents[xf].decode("utf-8", errors="replace")
            span = _find_citation_in_html(html_text, part, index_cache=file_indexes[xf])
            if span:
                matches[xf].append((span[0], span[1], note))
                found = True
                found_count += 1
                break
        if not found:
            not_found.append(part)

    # 4. Вставляем подсветки
    for xf in xhtml_files:
        if not matches[xf]:
            continue
        html_text = contents[xf].decode("utf-8", errors="replace")
        html_text = _insert_marks(html_text, matches[xf])
        contents[xf] = html_text.encode("utf-8")

    if found_count == 0:
        print("  No citations found in EPUB")
        return 0, len(not_found)

    # 5. CSS и запись
    _inject_highlight_css(contents, names)
    _write_epub(epub_path, names, contents)

    print(f"  Citations highlighted: {found_count}")
    if not_found:
        print(f"  Citations not found: {len(not_found)}")
        for p in not_found[:10]:
            print(f"    - {p[:80]}")
        if len(not_found) > 10:
            print(f"    ... and {len(not_found) - 10} more")

    return found_count, len(not_found)


# ------------------------------------------------------ диспетчер ---

SUPPORTED_NATIVE = {".pdf", ".epub"}


def add_citations_to_document(doc_filename, citations):
    """
    Добавляет подсветку в документ.
    PDF и EPUB обрабатываются нативно, остальные форматы конвертируются в PDF.
    Возвращает (успех, путь_к_результату).
    """
    doc_path = Path(doc_filename)
    ext = doc_path.suffix.lower()
    output_path = doc_filename

    if ext == ".epub":
        num_found, num_not_found = add_highlights_to_epub(doc_filename, citations)
    elif ext == ".pdf":
        num_found, num_not_found = _add_highlights_to_pdf(doc_filename, citations)
    else:
        pdf_path = str(doc_path.with_suffix(".pdf"))
        print(f"  Converting {doc_path.name} -> {Path(pdf_path).name}")
        book_to_pdf(doc_filename, pdf_path)
        output_path = pdf_path
        num_found, num_not_found = _add_highlights_to_pdf(pdf_path, citations)

    return num_not_found == 0, output_path


def book_to_pdf(book_filename, pdf_filename):
    if shutil.which("ebook-convert") is None:
        raise RuntimeError(
            "ebook-convert not found. Install Calibre to convert "
            f"{book_filename} to PDF."
        )
    subprocess.check_call(["ebook-convert", str(book_filename), str(pdf_filename)])


# ------------------------------------------------------- сборка ---


def locate_book(book_filename, working_directory, data_path, extra_names=None):
    """
    Ищет файл книги в рабочих директориях.
    Пробует точное совпадение, затем альтернативные имена,
    затем поиск по подстроке.
    """
    wanted = Path(book_filename).name
    # Список имён для точного поиска (основное + альтернативные)
    candidates = [wanted]
    if extra_names:
        for name in extra_names:
            if name and name not in candidates:
                candidates.append(name)

    for directory in (working_directory, data_path):
        root = Path(os.path.expanduser(directory))
        if not root.is_dir():
            continue

        # 1. Точное совпадение по каждому имени-кандидату
        for name in candidates:
            for found in root.rglob(name):
                if found.is_file():
                    return found

        # 2. Поиск по подстроке: имя книги без расширения внутри имени файла
        stem = Path(wanted).stem  # название без расширения
        if len(stem) >= 4:  # чтобы не искать по слишком коротким строкам
            for found in root.iterdir():
                if found.is_file() and stem.lower() in found.name.lower():
                    return found

    return None


def make_highlighted_pdf(
    readera_backup_filename,
    book_filename,
    working_directory=".",
    data_path=".",
    with_keywords=True,
    state="all",
    epub_to_pdf=False,
):
    book_info = get_citations_by_file(readera_backup_filename, book_filename, state)
    if not book_info:
        print(f"Book {book_filename} not found in readera's database")
        return False

    extra_names = []
    if book_info.title:
        ext = Path(book_filename).suffix or ".epub"
        extra_names.append(book_info.title + ext)

    found = locate_book(
        book_filename, working_directory, data_path, extra_names=extra_names
    )
    if found is None:
        print(f"Book file not found: {book_filename}")
        return False

    print(f"  Found: {found.name}")

    workdir = Path(os.path.expanduser(working_directory))
    workdir.mkdir(parents=True, exist_ok=True)

    target = workdir / found.name
    if with_keywords and not target.stem.endswith("__note"):
        target = target.with_stem(target.stem + "__note")

    file_ext = found.suffix.lower()

    # Определяем, нужно ли конвертировать в PDF
    need_convert = file_ext not in SUPPORTED_NATIVE
    if file_ext == ".epub" and epub_to_pdf:
        need_convert = True

    if need_convert:
        target = target.with_suffix(".pdf")
        print(f"  Converting {found.name} -> {target.name}")
        book_to_pdf(found, target)
    else:
        shutil.copy2(found, target)

    success, target = add_citations_to_document(str(target), book_info.citations)
    print(f"Produced highlighted file: {target}")
    print("OK" if success else "ERROR")
    return success


def make_highlighted_bystate(
    readera_backup_filename,
    working_directory,
    data_path,
    with_keywords,
    state,
    epub_to_pdf,
):
    infos = get_all_citations(readera_backup_filename, state)
    for book_info in sorted(infos.values(), key=lambda b: b.title):
        if book_info.citations:
            print(book_info.filename)
            make_highlighted_pdf(
                readera_backup_filename,
                book_info.filename,
                working_directory,
                data_path,
                with_keywords,
                state,
                epub_to_pdf,
            )


# ---------------------------------------------------------------- CLI ---


def parse_args():
    parser = argparse.ArgumentParser(description="Readera Highlighter")
    parser.add_argument(
        "--verify-citations-complete",
        action="store_true",
        help="check all backup files and show which citations are missing",
    )
    parser.add_argument(
        "--show-titles", action="store_true", help="show all books with citations"
    )
    parser.add_argument("--add-highlights", help="add highlights from ReadEra backup")
    parser.add_argument(
        "--add-highlights-bystate",
        action="store_true",
        help="add highlights for books filtered by --state",
    )
    parser.add_argument("--show-citations", help="show citations for a book")
    parser.add_argument(
        "--readera-backup-path",
        default=".",
        help="directory with ReadEra .bak files (default: current)",
    )
    parser.add_argument(
        "--readera-data-path",
        default=".",
        help="directory with ReadEra book files (default: current)",
    )
    parser.add_argument(
        "--working-directory",
        default=".",
        help="directory for output files (default: current)",
    )
    parser.add_argument(
        "--with-keywords",
        action=argparse.BooleanOptionalAction,
        default=True,
        help="write output to a copy with the '__note' suffix "
        "(default: enabled; use --no-with-keywords to disable)",
    )
    parser.add_argument(
        "--state",
        choices=["all", "readed"],
        default="all",
        help="filter books by reading state",
    )
    parser.add_argument(
        "--epub-pdf",
        action=argparse.BooleanOptionalAction,
        default=False,
        help="convert EPUB to PDF for proper annotation support "
        "(default: use <mark> tags in EPUB)",
    )
    parser.add_argument("--debug", action="store_true", help="dump book text")
    return parser.parse_args()


def main():
    args = parse_args()

    if args.verify_citations_complete:
        verify_citations_complete(args.readera_backup_path)
        return

    backup = find_backup_path(args.readera_backup_path)
    if backup is None:
        sys.exit(1)
    print(f"Using {backup}")

    if args.show_titles:
        show_titles(backup, args.state)
    elif args.show_citations is not None:
        show_citations_for_book(backup, args.show_citations, args.state)
    elif args.add_highlights is not None:
        ok = make_highlighted_pdf(
            backup,
            args.add_highlights,
            args.working_directory,
            args.readera_data_path,
            args.with_keywords,
            args.state,
            args.epub_pdf,
        )
        sys.exit(0 if ok else 1)
    elif args.add_highlights_bystate:
        make_highlighted_bystate(
            backup,
            args.working_directory,
            args.readera_data_path,
            args.with_keywords,
            args.state,
            args.epub_pdf,
        )
    else:
        sys.exit("No action selected. Use --help.")


if __name__ == "__main__":
    main()
