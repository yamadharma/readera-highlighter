BOOK_EXTENSIONS = (
    ".epub",
    ".pdf",
    ".fb2",
    ".djvu",
    ".mobi",
    ".azw",
    ".azw3",
    ".cbz",
    ".txt",
    ".fb2.zip",
)


def _is_book_file(path):
    name = path.name.lower()
    if name.endswith(".json") or name.endswith("-annotations.json"):
        return False
    for ext in BOOK_EXTENSIONS:
        if name.endswith(ext):
            return True
    return False


def locate_book(book_filename, working_directory, data_path, extra_names=None):
    wanted = Path(book_filename).name
    candidates = [wanted]
    if extra_names:
        for name in extra_names:
            if name and name not in candidates:
                candidates.append(name)
    for directory in (working_directory, data_path):
        root = Path(os.path.expanduser(directory))
        if not root.is_dir():
            continue
        for name in candidates:
            for found in root.rglob(name):
                if found.is_file() and _is_book_file(found):
                    return found
        stem = Path(wanted).stem
        if len(stem) >= 4:
            for found in root.iterdir():
                if (
                    found.is_file()
                    and _is_book_file(found)
                    and stem.lower() in found.name.lower()
                ):
                    return found
    return None


def make_highlighted_pdf(
    readera_backup_filename,
    book_filename,
    working_directory=".",
    data_path=".",
    with_keywords=True,
    state="all",
):
    book_info = get_citations_by_file(readera_backup_filename, book_filename, state)
    if not book_info:
        print(f"Book {book_filename} not found in readera's database")
        return False

    extra_names = []
    if book_info.title:
        ext = Path(book_filename).suffix or ".epub"
        extra_names.append(book_info.title + ext)

    found = locate_book(
        book_filename, working_directory, data_path, extra_names=extra_names
    )
    if found is None:
        print(f"Book file not found: {book_filename}")
        return False

    print(f"  Found: {found.name}")
    file_ext = found.suffix.lower()
    workdir = Path(os.path.expanduser(working_directory))
    workdir.mkdir(parents=True, exist_ok=True)

    if file_ext == ".epub":
        target = workdir / found.name
        if with_keywords and not target.stem.endswith("__note"):
            target = target.with_stem(target.stem + "__note")
        shutil.copy2(found, target)

        print(f"  Встраивание подсветки в текст {target.name}...")
        n_inline, n_not_found_inline = embed_highlights_inline_epub(
            str(target), book_info.citations
        )

        foliate_json_path, n_foliate, _ = generate_foliate_json(
            str(target), book_info.citations, str(workdir)
        )
        org_noter_path, n_org, _ = generate_org_noter_notes(
            str(target), book_info.citations, str(workdir), book_info.title
        )

        print(f"OK: {target.name}")
        print(f"  ✓ Подсвечено в тексте: {n_inline}")
        if foliate_json_path:
            print(f"  ✓ Foliate JSON: {foliate_json_path.name}")
        if org_noter_path:
            print(f"  ✓ Org-noter файл: {org_noter_path.name}")
        if n_not_found_inline > 0:
            print(f"  ! Не найдено в тексте: {n_not_found_inline}")
        return True

    target = workdir / found.name
    if with_keywords and not target.stem.endswith("__note"):
        target = target.with_stem(target.stem + "__note")
    if file_ext != ".pdf":
        target = target.with_suffix(".pdf")
        print(f"  Converting {found.name} -> {target.name}")
        book_to_pdf(found, target)
    else:
        shutil.copy2(found, target)

    num_found, num_not_found = _add_highlights_to_pdf(str(target), book_info.citations)
    print(f"Produced highlighted file: {target}")
    print("OK" if num_found else "ERROR")
    return num_found > 0


def make_highlighted_bystate(
    readera_backup_filename, working_directory, data_path, with_keywords, state
):
    infos = get_all_citations(readera_backup_filename, state)
    for book_info in sorted(infos.values(), key=lambda b: b.title):
        if book_info.citations:
            print(book_info.filename)
            make_highlighted_pdf(
                readera_backup_filename,
                book_info.filename,
                working_directory,
                data_path,
                with_keywords,
                state,
            )


