def parse_args():
    parser = argparse.ArgumentParser(description="Readera Highlighter")
    parser.add_argument(
        "--verify-citations-complete",
        action="store_true",
        help="check all backup files",
    )
    parser.add_argument(
        "--show-titles", action="store_true", help="show all books with citations"
    )
    parser.add_argument("--add-highlights", help="add highlights from ReadEra backup")
    parser.add_argument(
        "--add-highlights-bystate",
        action="store_true",
        help="add highlights for books filtered by --state",
    )
    parser.add_argument("--show-citations", help="show citations for a book")
    parser.add_argument(
        "--readera-backup-path", default=".", help="directory with ReadEra .bak files"
    )
    parser.add_argument(
        "--readera-data-path", default=".", help="directory with ReadEra book files"
    )
    parser.add_argument(
        "--working-directory", default=".", help="directory for output files"
    )
    parser.add_argument(
        "--with-keywords",
        action=argparse.BooleanOptionalAction,
        default=True,
        help="write output to a copy with the '__note' suffix",
    )
    parser.add_argument(
        "--state",
        choices=["all", "readed"],
        default="all",
        help="filter books by reading state",
    )
    parser.add_argument("--debug", action="store_true", help="dump book text")
    return parser.parse_args()


def main():
    args = parse_args()
    if args.verify_citations_complete:
        verify_citations_complete(args.readera_backup_path)
        return

    backup = find_backup_path(args.readera_backup_path)
    if backup is None:
        sys.exit(1)
    print(f"Using {backup}")

    if args.show_titles:
        show_titles(backup, args.state)
    elif args.show_citations is not None:
        show_citations_for_book(backup, args.show_citations, args.state)
    elif args.add_highlights is not None:
        ok = make_highlighted_pdf(
            backup,
            args.add_highlights,
            args.working_directory,
            args.readera_data_path,
            args.with_keywords,
            args.state,
        )
        sys.exit(0 if ok else 1)
    elif args.add_highlights_bystate:
        make_highlighted_bystate(
            backup,
            args.working_directory,
            args.readera_data_path,
            args.with_keywords,
            args.state,
        )
    else:
        sys.exit("No action selected. Use --help.")


if __name__ == "__main__":
    main()
