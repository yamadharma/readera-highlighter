#!/usr/bin/env python3
# -*- coding: utf-8 -*-

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
from dataclasses import dataclass, field
from pathlib import Path
from zipfile import ZipFile
import pymupdf as fitz

# ----------------------------------------------------------------- модели ---


@dataclass
class BookInfo:
    title: str
    filename: str
    citations: set = field(default_factory=set)


# ------------------------------------------------------------- чтение БД ---


def find_library_data_in_zip(zf):
    """
    Ищет данные библиотеки в ZIP-архиве.
    Поддерживает два формата:
    1. Старый: один файл library.json
    2. Новый: несколько файлов docs_N.json (фрагменты)

    Возвращает: (тип, данные)
    - ('single', 'library.json') для старого формата
    - ('split', ['docs_1.json', 'docs_2.json', ...]) для нового
    - None если ничего не найдено
    """
    names = zf.namelist()

    # 1. Старый формат: один library.json
    if "library.json" in names:
        return ("single", "library.json")

    for name in names:
        if name.endswith("/library.json") or name.endswith("\\library.json"):
            return ("single", name)

    # 2. Новый формат: фрагменты docs_N.json
    docs_files = []
    for name in names:
        basename = name.split("/")[-1].split("\\")[-1]
        if basename.startswith("docs_") and basename.endswith(".json"):
            docs_files.append(name)

    if docs_files:
        # Сортируем по номеру: docs_1.json, docs_2.json, ...
        def extract_number(filename):
            basename = filename.split("/")[-1].split("\\")[-1]
            # docs_1.json -> 1
            num_part = basename[5:-5]  # убираем "docs_" и ".json"
            try:
                return int(num_part)
            except ValueError:
                return 0

        docs_files.sort(key=extract_number)
        return ("split", docs_files)

    # 3. Ничего не найдено — показываем содержимое архива
    print(f"Archive contents ({len(names)} files):")
    for name in sorted(names)[:30]:
        print(f"  {name}")
    if len(names) > 30:
        print(f"  ... and {len(names) - 30} more")
    return None


def load_library_data(zf, library_info):
    """
    Загружает данные библиотеки из ZIP-архива.
    Новый формат: каждый docs_N.json — самостоятельный JSON-массив объектов.
    """
    if library_info is None:
        return None

    fmt, data = library_info

    if fmt == "single":
        with zf.open(data) as f:
            return json.load(f)

    elif fmt == "split":
        all_docs = []

        for filename in data:
            with zf.open(filename) as f:
                content = f.read().decode("utf-8").strip()

            try:
                # Каждый файл — самостоятельный JSON-массив
                docs = json.loads(content)
                if isinstance(docs, list):
                    all_docs.extend(docs)
                    print(f"    {filename}: {len(docs)} books")
                else:
                    print(f"    {filename}: unexpected type {type(docs)}")
            except json.JSONDecodeError:
                # Файл может быть фрагментом-продолжением (начинается с ',')
                # Убираем ведущую запятую, оборачиваем в массив
                stripped = content.lstrip(" \t\n\r,")
                try:
                    docs = json.loads("[" + stripped + "]")
                    all_docs.extend(docs)
                    print(f"    {filename}: {len(docs)} books (continuation)")
                except json.JSONDecodeError as e:
                    print(f"    {filename}: FAILED to parse: {e}")
                    print(f"    First 200 chars: {content[:200]}")
                    return None

        print(f"    Total: {len(all_docs)} books")
        return {"docs": all_docs}

    return None


def get_all_citations(readera_backup_filename, state="all"):
    uris_to_book_infos = {}
    print(f"Reading {readera_backup_filename}")

    with ZipFile(readera_backup_filename) as backup_file:
        library_info = find_library_data_in_zip(backup_file)
        if library_info is None:
            raise FileNotFoundError(
                f"No library data found in {readera_backup_filename}. "
                "Expected library.json or docs_*.json files."
            )

        fmt, data = library_info
        if fmt == "single":
            print(f"  Found old format: {data}")
        else:
            print(f"  Found new format: {len(data)} fragments")

        library_data = load_library_data(backup_file, library_info)
        if library_data is None:
            raise ValueError(
                f"Failed to parse library data from {readera_backup_filename}"
            )

    for doc in library_data.get("docs", []):
        doc_data = doc.get("data", {})

        if state == "readed" and not doc_data.get("doc_have_read_time", 0):
            continue

        book_title = (
            doc_data.get("doc_title")
            or doc_data.get("doc_file_name_title")
            or "Untitled"
        )
        book_format = str(doc_data.get("doc_format", "epub")).lower()
        doc_links = doc.get("links") or []

        if doc_links and doc_links[0].get("file_name"):
            book_filename = doc_links[0]["file_name"]
        else:
            book_filename = f"{book_title}.{book_format}"

        book_info = BookInfo(book_title, book_filename, set())
        uris_to_book_infos[doc["uri"]] = book_info

        for citation in doc.get("citations", []):
            body = citation.get("note_body")
            if not body:
                continue
            position = (citation.get("note_page") or 0) + (
                citation.get("note_index") or 0
            )
            book_info.citations.add((body, position, citation.get("note_extra")))

    return uris_to_book_infos


def find_backup_path(backup_path):
    env_path = os.getenv("READERA_BACKUP")
    if env_path:
        return Path(env_path)

    candidates = tuple(Path(os.path.expanduser(backup_path)).glob("ReadEra*.bak"))
    if not candidates:
        print(f"Did not find any ReadEra backup in {backup_path}")
        return None
    return max(candidates, key=lambda f: f.stat().st_mtime)


# ---------------------------------------------------------------- режимы ---


def verify_citations_complete(backup_path):
    """Сравнивает все бэкапы и показывает, каких цитат в них не хватает."""
    all_infos = {}
    backups_to_map = {}

    for filename in sorted(
        Path(os.path.expanduser(backup_path)).glob("ReadEra*bak"),
        reverse=True,
    ):
        infos = get_all_citations(filename)
        backups_to_map[filename] = infos
        for uri, book_info in infos.items():
            if uri not in all_infos:
                all_infos[uri] = BookInfo(book_info.title, book_info.filename, set())
            all_infos[uri].citations.update(book_info.citations)

    for filename, infos in backups_to_map.items():
        print(f"Checking {filename}")
        complete = True
        for uri, full_info in all_infos.items():
            current = infos.get(uri)
            if current is None:
                print(f"  Missing title: {full_info.title}")
                complete = False
                continue
            missing = full_info.citations - current.citations
            for citation in sorted(missing, key=lambda item: item[1]):
                print(f"  Missing citation: {full_info.title} / {citation}")
                complete = False
        if complete:
            print("  Contains all citations")


def show_titles(readera_backup_filename, state="all"):
    infos = get_all_citations(readera_backup_filename, state)
    for book_info in sorted(infos.values(), key=lambda b: b.title):
        if book_info.citations:
            print(f"{book_info.title}, Citations: {len(book_info.citations)}")


def get_citations_by_file(readera_backup_filename, book_filename, state="all"):
    wanted = Path(book_filename).name
    infos = get_all_citations(readera_backup_filename, state)
    for book_info in infos.values():
        if Path(book_info.filename).name == wanted:
            return book_info
    return None


def show_citations_for_book(readera_backup_filename, book, state="all"):
    if Path(book).is_file():
        print(f"Searching for file '{book}'")
        book_info = get_citations_by_file(
            readera_backup_filename, Path(book).name, state
        )
    else:
        print(f"Searching for title '{book}'")
        infos = get_all_citations(readera_backup_filename, state)
        book_info = next(
            (b for b in infos.values() if book.lower() in b.title.lower()),
            None,
        )

    if not book_info:
        print("Book not found")
        return

    print(f"Book: {book_info.title}")
    for citation in sorted(book_info.citations, key=lambda item: item[1]):
        print(f"- {citation[0]}\n")


# ----------------------------------------------------- поиск и подсветка ---

LANGS = [
    "ÁáČčĎďÉéĚěÍíŇňÓóŘřŠšŤťÚúŮůÝýŽž",  # Czech
    "ÄäÖöÜüẞß",  # German
    "ĄąĆćĘęŁłŃńÓóŚśŹźŻż",  # Polish
    "À-ú",  # Portuguese
    "Ёё",  # Russian
]
TOKEN_RE = re.compile(r"[A-Za-zА-Яа-я0-9!?.,;:'\"" + "".join(LANGS) + "]")


def tokenize(text):
    return TOKEN_RE.findall(text)


def build_text_index(doc):
    """
    Один поток символов для всей книги.
    Для каждого символа помним: номер страницы, прямоугольник слова,
    ключ строки (чтобы группировать подсветку по строкам).
    """
    chars = []
    records = []

    for page_index, page in enumerate(doc):
        textpage = page.get_textpage(flags=fitz.TEXT_MEDIABOX_CLIP)
        for word_info in textpage.extractWORDS():
            word = word_info[4]
            rect = fitz.Rect(word_info[:4])
            line_key = round(rect.y0, 1)
            for token in tokenize(word):
                for char in token:
                    chars.append(char)
                    records.append((page_index, rect, line_key))

    return "".join(chars), records


def remove_existing_highlights(doc):
    """Удаляет все существующие highlight-аннотации из документа."""
    removed_count = 0
    for page in doc:
        annots = list(page.annots() or [])
        for annot in annots:
            if annot.type[0] == fitz.PDF_ANNOT_HIGHLIGHT:
                page.delete_annot(annot)
                removed_count += 1
    if removed_count > 0:
        print(f"Removed {removed_count} existing highlight(s)")


def add_citations_to_document(doc_filename, citations):
    """
    Добавляет подсветку в PDF или EPUB файл.
    Автоматически удаляет существующие highlight-аннотации перед добавлением новых.
    """
    doc = fitz.open(doc_filename)
    num_found = num_not_found = 0
    is_epub = doc_filename.lower().endswith(".epub")

    try:
        # Защита от повторной подсветки: удаляем существующие аннотации
        remove_existing_highlights(doc)

        text, records = build_text_index(doc)
        search_from = 0

        for citation, _, note in sorted(citations, key=lambda item: item[1]):
            for part in citation.split("\n"):
                needle = "".join(tokenize(part))
                if not needle:
                    continue

                # Ищем по порядку чтения, при неудаче — с начала книги.
                pos = text.find(needle, search_from)
                if pos < 0:
                    pos = text.find(needle)

                if pos < 0:
                    print(f"Citation not found: {part!r}")
                    num_not_found += 1
                    continue

                # Группируем совпавшие символы по (страница, строка).
                groups = []
                for page_index, rect, line_key in records[pos : pos + len(needle)]:
                    key = (page_index, line_key)
                    if groups and groups[-1][0] == key:
                        groups[-1][1] |= rect
                    else:
                        groups.append([key, fitz.Rect(rect)])

                for (page_index, _), rect in groups:
                    page = doc[page_index]
                    annot = page.add_highlight_annot(rect)
                    if note:
                        annot.set_info(content=note)
                    annot.update()

                search_from = pos + len(needle)
                num_found += 1

        # Сохраняем изменения
        if num_found:
            if is_epub:
                # Для EPUB используем save() вместо saveIncr()
                doc.save(doc_filename, incremental=False, encryption=0)
            else:
                # Для PDF используем saveIncr()
                doc.saveIncr()
    finally:
        doc.close()

    print(f"Citations found: {num_found}")
    if num_not_found:
        print(f"Citations not found: {num_not_found}")
        if "--debug" in sys.argv:
            debug_doc = fitz.open(doc_filename)
            try:
                with open("book.txt", "w", encoding="utf-8") as f:
                    for page in debug_doc:
                        print(page.get_text(), file=f)
                        print(file=f)
            finally:
                debug_doc.close()
        return False
    return True


def book_to_pdf(book_filename, pdf_filename):
    if shutil.which("ebook-convert") is None:
        raise RuntimeError(
            "ebook-convert not found. Install Calibre to convert "
            f"{book_filename} to PDF."
        )
    subprocess.check_call(["ebook-convert", str(book_filename), str(pdf_filename)])


# ------------------------------------------------------- сборка подсветки ---


def locate_book(book_filename, working_directory, data_path):
    wanted = Path(book_filename).name
    for directory in (working_directory, data_path):
        root = Path(os.path.expanduser(directory))
        if not root.is_dir():
            continue
        for found in root.rglob(wanted):
            if found.is_file():
                return found
    return None


def make_highlighted_pdf(
    readera_backup_filename,
    book_filename,
    working_directory=".",
    data_path=".",
    with_keywords=False,
    state="all",
):
    book_info = get_citations_by_file(readera_backup_filename, book_filename, state)
    if not book_info:
        print(f"Book {book_filename} not found in readera's database")
        return False

    found = locate_book(book_filename, working_directory, data_path)
    if found is None:
        print(f"Book file not found: {book_filename}")
        return False

    workdir = Path(os.path.expanduser(working_directory))
    workdir.mkdir(parents=True, exist_ok=True)
    target = workdir / found.name

    if found.resolve() != target.resolve():
        shutil.copy2(found, target)

    if with_keywords:
        target = target.with_stem(target.stem + "__note")
        shutil.copy2(found, target)

    # Работаем с PDF и EPUB напрямую, конвертация не нужна
    success = add_citations_to_document(str(target), book_info.citations)
    print(f"Produced highlighted file: {target}")
    print("OK" if success else "ERROR")
    return success


def make_highlighted_bystate(
    readera_backup_filename, working_directory, data_path, with_keywords, state
):
    infos = get_all_citations(readera_backup_filename, state)
    for book_info in sorted(infos.values(), key=lambda b: b.title):
        if book_info.citations:
            print(book_info.filename)
            make_highlighted_pdf(
                readera_backup_filename,
                book_info.filename,
                working_directory,
                data_path,
                with_keywords,
                state,
            )


# ------------------------------------------------------------------- CLI ---


def parse_args():
    parser = argparse.ArgumentParser(description="Readera Highlighter")
    parser.add_argument(
        "--verify-citations-complete",
        action="store_true",
        help="check all backup files and show which citations are missing",
    )
    parser.add_argument(
        "--show-titles", action="store_true", help="show all books with citations"
    )
    parser.add_argument("--add-highlights", help="add highlights from ReadEra backup")
    parser.add_argument(
        "--add-highlights-bystate",
        action="store_true",
        help="add highlights for books filtered by --state",
    )
    parser.add_argument("--show-citations", help="show citations for a book")
    parser.add_argument(
        "--readera-backup-path",
        default=".",
        help="directory with ReadEra .bak files (default: current)",
    )
    parser.add_argument(
        "--readera-data-path",
        default=".",
        help="directory with ReadEra book files (default: current)",
    )
    parser.add_argument(
        "--working-directory",
        default=".",
        help="directory for output files (default: current)",
    )
    parser.add_argument(
        "--with-keywords",
        action="store_true",
        default=False,
        help="write output to a copy with the '__note' suffix",
    )
    parser.add_argument(
        "--state",
        choices=["all", "readed"],
        default="all",
        help="filter books by reading state",
    )
    parser.add_argument("--debug", action="store_true", help="dump book text")
    return parser.parse_args()


def main():
    args = parse_args()

    if args.verify_citations_complete:
        verify_citations_complete(args.readera_backup_path)
        return

    backup = find_backup_path(args.readera_backup_path)
    if backup is None:
        sys.exit(1)
    print(f"Using {backup}")

    if args.show_titles:
        show_titles(backup, args.state)
    elif args.show_citations is not None:
        show_citations_for_book(backup, args.show_citations, args.state)
    elif args.add_highlights is not None:
        ok = make_highlighted_pdf(
            backup,
            args.add_highlights,
            args.working_directory,
            args.readera_data_path,
            args.with_keywords,
            args.state,
        )
        sys.exit(0 if ok else 1)
    elif args.add_highlights_bystate:
        make_highlighted_bystate(
            backup,
            args.working_directory,
            args.readera_data_path,
            args.with_keywords,
            args.state,
        )
    else:
        sys.exit("No action selected. Use --help.")


if __name__ == "__main__":
    main()
