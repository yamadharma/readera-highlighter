#  Генерация аннотаций
# ──────────────────────────────────────────────────────────────────────────────


def generate_calibre_bookmarks(epub_path, citations):
    generator = EpubCfiGenerator(epub_path)
    entries = []
    found_count = 0
    not_found_count = 0
    with ZipFile(epub_path) as zf:
        for citation_body, position, note in sorted(citations, key=lambda x: x[1]):
            for part in citation_body.split("\n"):
                part = part.strip()
                if not part:
                    continue
                loc = generator.find_citation_location(zf, part)
                if loc:
                    entry = {
                        "type": "highlight",
                        "uuid": str(uuid.uuid4()),
                        "timestamp": _now_iso(),
                        "spine_index": loc["spine_index"],
                        "spine_name": loc["spine_name"],
                        "start_cfi": loc["start_cfi"],
                        "end_cfi": loc["end_cfi"],
                        "highlighted_text": part,
                        "style": {
                            "kind": "color",
                            "type": "builtin",
                            "which": "yellow",
                        },
                    }
                    if note:
                        entry["notes"] = note
                    entries.append(entry)
                    found_count += 1
                else:
                    not_found_count += 1
    if not entries:
        return None, 0, 0
    json_str = json.dumps(entries, ensure_ascii=False, separators=(",", ":"))
    b64 = base64.b64encode(json_str.encode("utf-8")).decode("ascii")
    return "encoding=json+base64:" + b64, found_count, not_found_count


def embed_calibre_bookmarks(epub_path, bookmarks_content):
    with ZipFile(epub_path) as zin:
        contents = {n: zin.read(n) for n in zin.namelist()}
    contents["META-INF/calibre_bookmarks.txt"] = bookmarks_content.encode("utf-8")
    names = list(contents.keys())
    ordered = (["mimetype"] if "mimetype" in names else []) + [
        n for n in names if n != "mimetype"
    ]
    with ZipFile(epub_path, "w", ZIP_DEFLATED) as zout:
        for name in ordered:
            if name == "mimetype":
                zout.writestr(name, contents[name], compress_type=ZIP_STORED)
            else:
                zout.writestr(name, contents[name])


def generate_foliate_json(epub_path, citations, output_dir):
    generator = EpubCfiGenerator(epub_path)
    epub_name = Path(epub_path).stem
    annotations = []
    found_count = 0
    not_found_count = 0
    with ZipFile(epub_path) as zf:
        for citation_body, position, note in sorted(citations, key=lambda x: x[1]):
            for part in citation_body.split("\n"):
                part = part.strip()
                if not part:
                    continue
                cfi = generator.find_cfi_for_citation(zf, part)
                if cfi:
                    annotations.append(
                        {
                            "value": cfi,
                            "color": "yellow",
                            "text": part,
                            "note": note or "",
                            "created": _now_iso(),
                            "modified": _now_iso(),
                        }
                    )
                    found_count += 1
                else:
                    not_found_count += 1
    if not annotations:
        return None, 0, 0
    result = {"annotations": annotations}
    output_path = Path(output_dir) / f"{epub_name}-foliate.json"
    with open(output_path, "w", encoding="utf-8") as f:
        json.dump(result, f, ensure_ascii=False, indent=2)
    print(f"  Foliate JSON: {found_count} аннотаций, {not_found_count} не найдено")
    print(f"  Файл сохранён: {output_path}")
    return output_path, found_count, not_found_count


def generate_org_noter_notes(epub_path, citations, output_dir, book_title):
    generator = EpubCfiGenerator(epub_path)
    epub_name = Path(epub_path).stem
    org_lines = []
    org_lines.append(f"#+TITLE: Notes for {book_title}")
    org_lines.append(f"#+AUTHOR: ReadEra Highlighter")
    org_lines.append(f"#+DATE: {_now_iso()}")
    org_lines.append("")
    org_lines.append("* Notes")
    org_lines.append("  :PROPERTIES:")
    org_lines.append("  :NOTER_DOCUMENT: " + str(epub_path))
    org_lines.append("  :END:")
    org_lines.append("")
    found_count = 0
    not_found_count = 0
    with ZipFile(epub_path) as zf:
        for citation_body, position, note in sorted(citations, key=lambda x: x[1]):
            for part in citation_body.split("\n"):
                part = part.strip()
                if not part:
                    continue
                cfi = generator.find_cfi_for_citation(zf, part)
                if cfi:
                    heading_text = part[:60].replace("\n", " ") + (
                        "..." if len(part) > 60 else ""
                    )
                    org_lines.append(f"** {heading_text}")
                    org_lines.append("   :PROPERTIES:")
                    org_lines.append(f'   :NOTER_PAGE: (cfi "{cfi}")')
                    org_lines.append("   :END:")
                    org_lines.append("")
                    org_lines.append("   #+begin_quote")
                    for line in part.split("\n"):
                        org_lines.append(f"   {line}")
                    org_lines.append("   #+end_quote")
                    org_lines.append("")
                    if note:
                        org_lines.append("   " + note.replace("\n", "\n   "))
                        org_lines.append("")
                    found_count += 1
                else:
                    not_found_count += 1
    if found_count == 0:
        return None, 0, 0
    output_path = Path(output_dir) / f"{epub_name}_notes.org"
    with open(output_path, "w", encoding="utf-8") as f:
        f.write("\n".join(org_lines))
    print(f"  Org-noter: {found_count} аннотаций, {not_found_count} не найдено")
    print(f"  Файл сохранён: {output_path}")
    return output_path, found_count, not_found_count


def embed_highlights_inline_epub(epub_path, citations):
    """
    Встраивает аннотации прямо в XHTML-файлы EPUB как теги <mark>.
    Это гарантирует, что аннотации никогда не будут удалены читалкой.
    """
    generator = EpubCfiGenerator(epub_path)
    found_count = 0
    not_found_count = 0

    # 1. Читаем всё содержимое в память
    with ZipFile(epub_path) as zin:
        contents = {n: zin.read(n) for n in zin.namelist()}

    xhtml_files = [
        n
        for n in contents
        if n.endswith((".xhtml", ".html", ".htm")) and "META-INF" not in n
    ]
    css_added = False
    css_content = b"""
    mark.readera-hl {
        background-color: #FFEB3B !important;
        color: inherit !important;
        border-radius: 2px;
        padding: 0 2px;
    }
    """

    # 2. Ищем цитаты (открываем архив заново для чтения, чтобы избежать блокировок)
    with ZipFile(epub_path) as zin:
        for citation_body, position, note in sorted(citations, key=lambda x: x[1]):
            for part in citation_body.split("\n"):
                part = part.strip()
                if not part:
                    continue

                loc = generator._locate_citation(zin, part)
                if not loc:
                    not_found_count += 1
                    continue

                spine_idx, itemref_id, href, s_steps, s_off, e_steps, e_off = loc
                target_file = None
                for xf in xhtml_files:
                    if href in xf or xf.endswith(href):
                        target_file = xf
                        break

                if not target_file or target_file not in contents:
                    not_found_count += 1
                    continue

                html_text = contents[target_file].decode("utf-8", errors="replace")
                norm_part = re.sub(r"\s+", " ", part).strip()
                words = norm_part.split()
                if not words:
                    continue

                # Регулярное выражение, допускающее пробелы и HTML-теги между словами
                pattern = r"\s*<?[^>]*>\s*".join(re.escape(w) for w in words)
                match = re.search(pattern, html_text, re.IGNORECASE | re.DOTALL)

                if match:
                    matched_text = match.group(0)
                    note_attr = f' title="{note}"' if note else ""
                    replacement = (
                        f'<mark class="readera-hl"{note_attr}>{matched_text}</mark>'
                    )

                    # Заменяем только первое вхождение
                    html_text = html_text.replace(matched_text, replacement, 1)
                    contents[target_file] = html_text.encode("utf-8")
                    found_count += 1
                    if not css_added:
                        css_added = True
                else:
                    not_found_count += 1

    # 3. Внедряем CSS в первый XHTML-файл
    if css_added and xhtml_files:
        first_xhtml = xhtml_files[0]
        html_text = contents[first_xhtml].decode("utf-8", errors="replace")
        if "</head>" in html_text:
            html_text = html_text.replace(
                "</head>", f'<style>{css_content.decode("utf-8")}</style></head>', 1
            )
            contents[first_xhtml] = html_text.encode("utf-8")

    # 4. Перезаписываем EPUB (mimetype первым и без сжатия)
    names = list(contents.keys())
    ordered = (["mimetype"] if "mimetype" in names else []) + [
        n for n in names if n != "mimetype"
    ]

    with ZipFile(epub_path, "w", ZIP_DEFLATED) as zout:
        for name in ordered:
            if name == "mimetype":
                zout.writestr(name, contents[name], compress_type=ZIP_STORED)
            else:
                zout.writestr(name, contents[name])

    return found_count, not_found_count


