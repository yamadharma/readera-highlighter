def find_library_data_in_zip(zf):
    names = zf.namelist()
    if "library.json" in names:
        return ("single", "library.json")
    for name in names:
        if name.endswith("/library.json") or name.endswith("\\library.json"):
            return ("single", name)

    docs_files = []
    for name in names:
        basename = name.split("/")[-1].split("\\")[-1]
        if basename.startswith("docs_") and basename.endswith(".json"):
            docs_files.append(name)

    if docs_files:

        def extract_number(filename):
            basename = filename.split("/")[-1].split("\\")[-1]
            num_part = basename[5:-5]
            try:
                return int(num_part)
            except ValueError:
                return 0

        docs_files.sort(key=extract_number)
        return ("split", docs_files)

    print(f"Archive contents ({len(names)} files):")
    for name in sorted(names)[:30]:
        print(f"  {name}")
    if len(names) > 30:
        print(f"  ... and {len(names) - 30} more")
    return None


def load_library_data(zf, library_info):
    if library_info is None:
        return None

    fmt, data = library_info
    if fmt == "single":
        with zf.open(data) as f:
            return json.load(f)

    if fmt == "split":
        all_docs = []
        for filename in data:
            with zf.open(filename) as f:
                content = f.read().decode("utf-8").strip()
            try:
                docs = json.loads(content)
                if isinstance(docs, list):
                    all_docs.extend(docs)
                    print(f"    {filename}: {len(docs)} books")
                else:
                    print(f"    {filename}: unexpected type {type(docs).__name__}")
            except json.JSONDecodeError:
                stripped = content.lstrip(" \t\n\r,")
                try:
                    docs = json.loads("[" + stripped + "]")
                    all_docs.extend(docs)
                    print(f"    {filename}: {len(docs)} books (continuation)")
                except json.JSONDecodeError as e:
                    print(f"    {filename}: FAILED to parse: {e}")
                    return None
        print(f"    Total: {len(all_docs)} books")
        return {"docs": all_docs}

    return None


def get_all_citations(readera_backup_filename, state="all"):
    uris_to_book_infos = {}
    print(f"Reading {readera_backup_filename}")

    with ZipFile(readera_backup_filename) as backup_file:
        library_info = find_library_data_in_zip(backup_file)
        if library_info is None:
            raise FileNotFoundError(
                f"No library data found in {readera_backup_filename}."
            )

        fmt, data = library_info
        if fmt == "single":
            print(f"  Found old format: {data}")
        else:
            print(f"  Found new format: {len(data)} fragments")

        library_data = load_library_data(backup_file, library_info)
        if library_data is None:
            raise ValueError(
                f"Failed to parse library data from {readera_backup_filename}"
            )

    for doc in library_data.get("docs", []):
        doc_data = doc.get("data", {})
        if state == "readed" and not doc_data.get("doc_have_read_time", 0):
            continue

        book_title = (
            doc_data.get("doc_title")
            or doc_data.get("doc_file_name_title")
            or "Untitled"
        )
        book_format = str(doc_data.get("doc_format", "epub")).lower()
        doc_links = doc.get("links") or []

        if doc_links and doc_links[0].get("file_name"):
            book_filename = doc_links[0]["file_name"]
        else:
            book_filename = f"{book_title}.{book_format}"

        book_info = BookInfo(book_title, book_filename, set())
        uris_to_book_infos[doc["uri"]] = book_info

        for citation in doc.get("citations", []):
            body = citation.get("note_body")
            if not body:
                continue
            position = (citation.get("note_page") or 0) + (
                citation.get("note_index") or 0
            )
            book_info.citations.add((body, position, citation.get("note_extra")))

    return uris_to_book_infos


def find_backup_path(backup_path):
    env_path = os.getenv("READERA_BACKUP")
    if env_path:
        return Path(env_path)
    candidates = tuple(Path(os.path.expanduser(backup_path)).glob("ReadEra*.bak"))
    if not candidates:
        print(f"Did not find any ReadEra backup in {backup_path}")
        return None
    return max(candidates, key=lambda f: f.stat().st_mtime)


